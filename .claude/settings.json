{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/tdd-reminder.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/pre-commit-test.ts",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.env)",
      "Write(**/*credential*)",
      "Write(**/*secret*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.p12)",
      "Write(**/*.pfx)",
      "Write(**/id_rsa*)",
      "Write(**/id_ed25519*)",
      "Write(**/.npmrc)",
      "Write(**/.netrc)",
      "Write(**/.aws/**)",
      "Write(**/.ssh/**)",
      "Bash(*.env*)",
      "Bash(*credential*)",
      "Bash(*secret*)",
      "Bash(*.pem*)",
      "Bash(*id_rsa*)",
      "Bash(*id_ed25519*)",
      "Bash(*.npmrc*)",
      "Bash(*.netrc*)",
      "Bash(*.aws/*)",
      "Bash(*.ssh/*)",
      "PowerShell(*.env*)",
      "PowerShell(*credential*)",
      "PowerShell(*secret*)",
      "PowerShell(*.pem*)",
      "PowerShell(*id_rsa*)",
      "PowerShell(*id_ed25519*)",
      "PowerShell(*.npmrc*)",
      "PowerShell(*.netrc*)",
      "PowerShell(*.aws*)",
      "PowerShell(*.ssh*)"
    ]
  }
}
